<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy -> Node MCP server on 127.0.0.1:3000.
  Requires the IIS "URL Rewrite" and "Application Request Routing (ARR)" modules,
  and "Enable proxy" turned on in ARR > Server Proxy Settings.
  If you change PORT in .env, change it here too.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="EMS MCP reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
