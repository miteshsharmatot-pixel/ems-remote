# Public HTTPS URL users reach (no trailing slash, no /mcp). On Render this is set automatically.
PUBLIC_URL=https://ems-mcp.yourcompany.com
# Local port Node listens on (IIS proxies to this)
PORT=3000
# Long random string (32+ chars). Used to encrypt stored EMS passwords. DO NOT LOSE/CHANGE.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=
# Folder for encrypted user data + sessions (give ONLY the service account access)
DATA_DIR=./data
# Optional: Postgres connection string. If set, users/tokens/sessions are stored there instead of DATA_DIR
# (needed on hosts with no persistent disk, e.g. Render free).
# DATABASE_URL=postgres://user:password@host/dbname
EMS_BASE_URL=https://ems.theonetechnologies.co.in
# Max simultaneous headless browser jobs (login + leave forms)
MAX_CONCURRENT_JOBS=3
# Optional: ping our own /health every 8 min (stops Render's free plan from sleeping the instance)
# KEEP_ALIVE=1
# Optional: log every tool call with its duration
# LOG_REQUESTS=1
